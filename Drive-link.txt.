public with sharing class VenueStatusHelper {
    public static void updateVenueStatus(List<Event__c> events) {
        List<Venue__c> venues = new List<Venue__c>();

        for (Event__c ev : events) {
            if (ev.Venue__c != null) {

                if (ev.Event_Status__c == 'Confirmed') {
                    venues.add(
                        new Venue__c(
                            Id = ev.Venue__c,
                            Availability_Status__c = 'Reserved'
                        )
                    );
                }
                else if (ev.Event_Status__c == 'Canceled') {
                    venues.add(
                        new Venue__c(
                            Id = ev.Venue__c,
                            Availability_Status__c = 'Available'
                        )
                    );
                }
            }
        }

        if (!venues.isEmpty()) {
            update venues;
        }
    }
}

This class changes the Venue status to Reserved when an event is confirmed and Available when it is cancelled.

