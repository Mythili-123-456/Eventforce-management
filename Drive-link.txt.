global class ScheduleCompleteEvents
    implements Schedulable {

    global void execute(SchedulableContext sc) {

        Database.executeBatch(
            new BatchCompleteEvents(),
            200
        );

    }
}

This scheduled class runs the BatchCompleteEvents batch automatically.

